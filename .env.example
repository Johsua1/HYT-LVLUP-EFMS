# EFMS environment template — copy to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored (.env, .env.local, .env.*.local) and must NEVER be
# committed. This template must contain placeholders only.
#
# Vite only exposes variables prefixed with VITE_ to the browser, so those must
# use the VITE_ prefix (NOT the Next.js NEXT_PUBLIC_ prefix).
#
# Find these under: Supabase Dashboard → Project Settings → API.
# The anon (public) key is safe to ship — every table is protected by RLS.
# The service_role key bypasses RLS and must stay server-side only.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only. Never import this into src/ and never place it in .env.local
# (the file Vite reads) — keep it in the git-ignored .env.admin.local. It is used
# exclusively by the admin-staff Edge Function (as a platform secret) and by
# local admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Blocks right-click and the DevTools shortcuts in the browser. This is
# a cosmetic deterrent only — it is trivially bypassed and is NOT the security
# boundary (Row Level Security is). Set to "false" to re-enable Inspect while
# debugging. Defaults to enabled when unset.
VITE_BLOCK_INSPECT=true

# Server-side only — set as Edge Function secrets (`supabase secrets set`), NOT
# in .env.local. They restrict the admin-staff function's CORS allow-list and
# the login link it puts in invitation emails.
#   SITE_URL=https://your-production-domain
#   ALLOWED_ORIGINS=https://your-production-domain,https://your-preview-domain
# When neither is set the function falls back to `*` so a deployment is never
# broken by a missing variable — set them to lock the endpoint down.
